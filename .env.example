# ---------------------------------------------------------------------
# Diallo Coaching — variables d'environnement
# Copier ce fichier en .env.local (jamais commité) puis renseigner les valeurs.
#
# Phase 1 : AUCUNE variable n'est requise. Sans elles, l'application tourne
# en mode démonstration avec des données fictives.
#
# Aucune variable n'est préfixée NEXT_PUBLIC_ : elles restent côté serveur et
# ne sont jamais envoyées au navigateur.
# ---------------------------------------------------------------------

# Supabase (Project Settings → API) — phase 2
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Clé secrète Supabase — opérations d'administration uniquement
# (suppression du compte, écriture des réponses du Mentor). Ne jamais partager.
SUPABASE_SECRET_KEY=

# Clé de l'API d'IA pour l'analyse des photos et le Mentor — phase 3
ANTHROPIC_API_KEY=
